# Where the browser sends API calls; keep it same-origin so the session cookie stays first-party.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# This app's own origin, used for metadataBase and absolute share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The Express API that next.config.ts rewrites /api/v1/* to. Server-only, never reaches the browser.
API_ORIGIN=http://localhost:8000
# Name of the backend's session cookie; proxy.ts checks for its presence only.
SESSION_COOKIE_NAME=tradeos_session
# Hostname of the bucket serving uploads. Leave unset and next/image allows no remote hosts.
# NEXT_PUBLIC_S3_HOSTNAME=
