import { beforeEach, describe, expect, it, vi } from "vitest";
import { apiDelete, apiGet, apiGetList, apiPatch, apiPost } from "@/lib/api/client";
import type { __Resource__ } from "../types";
import * as __resource__Service from "./__resource-kebab__.service";

/**
 * The service layer is worth testing precisely because it is boring: the bugs
 * it produces are a wrong path, a dropped filter, and an envelope unwrapped
 * twice — none of which show up as a type error, and all of which look like a
 * backend problem from the screen.
 *
 * Mocking `lib/api/client` rather than axios keeps the test about *this* file.
 * `vi.mock` is hoisted above the imports, so the bindings below are already the
 * mocks by the time the service module loads.
 */
vi.mock("@/lib/api/client", () => ({
  apiGet: vi.fn(),
  apiGetList: vi.fn(),
  apiPost: vi.fn(),
  apiPatch: vi.fn(),
  apiDelete: vi.fn(),
}));

const ID = "6520f0f0f0f0f0f0f0f0f0f0";

const fixture = (overrides: Partial<__Resource__> = {}): __Resource__ => ({
  id: ID,
  name: "Test __resourceLabel__",
  createdAt: "2026-09-07T10:00:00.000Z",
  updatedAt: "2026-09-07T10:00:00.000Z",
  ...overrides,
});

describe("__resource-kebab__.service", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("sends list filters through untouched", async () => {
    const page = { items: [fixture()], meta: { page: 2, limit: 25, total: 30, totalPages: 2 } };
    vi.mocked(apiGetList).mockResolvedValue(page);

    const result = await __resource__Service.list({ page: 2, limit: 25, search: "abc" });

    // The filters must arrive as given. A service that renames, defaults or
    // drops one is the hardest kind of bug to see: the request succeeds and
    // returns the wrong rows.
    expect(apiGetList).toHaveBeenCalledWith("/__resources-kebab__", {
      page: 2,
      limit: 25,
      search: "abc",
    });
    // And what comes back is already unwrapped — `items` and `meta`, not
    // `data.items`. If this assertion ever needs a `.data`, the interceptor
    // and this layer have both started unwrapping.
    expect(result).toEqual(page);
  });

  it("builds the detail path from the id", async () => {
    vi.mocked(apiGet).mockResolvedValue(fixture());

    await __resource__Service.getById(ID);

    expect(apiGet).toHaveBeenCalledWith(`/__resources-kebab__/${ID}`);
  });

  it("posts the create body as given", async () => {
    vi.mocked(apiPost).mockResolvedValue(fixture());

    await __resource__Service.create({ name: "New __resourceLabel__" });

    // No organization id, ever — not here, not in a header, not in the path.
    // The API resolves the tenant from the session (BACKEND-GUIDE §4), and a
    // stray key would be a 422 against a strict body.
    expect(apiPost).toHaveBeenCalledWith("/__resources-kebab__", { name: "New __resourceLabel__" });
  });

  it("patches only what it was given", async () => {
    vi.mocked(apiPatch).mockResolvedValue(fixture({ name: "Renamed" }));

    await __resource__Service.update(ID, { name: "Renamed" });

    expect(apiPatch).toHaveBeenCalledWith(`/__resources-kebab__/${ID}`, { name: "Renamed" });
  });

  it("deletes by id", async () => {
    vi.mocked(apiDelete).mockResolvedValue(undefined);

    await __resource__Service.remove(ID);

    expect(apiDelete).toHaveBeenCalledWith(`/__resources-kebab__/${ID}`);
  });
});

/* ============================================================================
 * FILE: features/__resources-kebab__/hooks/use-__resources-kebab__.test.tsx
 *
 * `.tsx`, because the wrapper renders a provider. Keep it beside the hooks it
 * covers rather than in a top-level tests folder — a hook and its test move
 * together when the feature does.
 * ==========================================================================*/

// @vitest-environment happy-dom

import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { renderHook, waitFor } from "@testing-library/react";
import type { ReactNode } from "react";
import { beforeEach, describe, expect, it, vi } from "vitest";
import { apiGetList, apiPost } from "@/lib/api/client";
import { __resource__Keys } from "../keys";
import type { __Resource__ } from "../types";
import { useCreate__Resource__, use__Resource__List } from "./use-__resources-kebab__";

vi.mock("@/lib/api/client", () => ({
  apiGet: vi.fn(),
  apiGetList: vi.fn(),
  apiPost: vi.fn(),
  apiPatch: vi.fn(),
  apiDelete: vi.fn(),
}));

const ID = "6520f0f0f0f0f0f0f0f0f0f0";

const row: __Resource__ = {
  id: ID,
  name: "Test __resourceLabel__",
  createdAt: "2026-09-07T10:00:00.000Z",
  updatedAt: "2026-09-07T10:00:00.000Z",
};

/**
 * A FRESH client per test. A shared one carries the previous test's cache, so
 * a hook can "pass" by reading data the test never fetched — and the failure
 * only shows up when the file order changes.
 *
 * `retry: false` because the retry policy is not what these tests are about,
 * and leaving it on turns one deliberate rejection into three and a timeout.
 */
function createWrapper() {
  const queryClient = new QueryClient({
    defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
  });

  const Wrapper = ({ children }: { children: ReactNode }) => (
    <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>
  );

  return { queryClient, Wrapper };
}

describe("use__Resource__List", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("returns the page the service resolved", async () => {
    vi.mocked(apiGetList).mockResolvedValue({
      items: [row],
      meta: { page: 1, limit: 25, total: 1, totalPages: 1 },
    });
    const { Wrapper } = createWrapper();

    const { result } = renderHook(() => use__Resource__List({ page: 1, limit: 25 }), {
      wrapper: Wrapper,
    });

    await waitFor(() => expect(result.current.isSuccess).toBe(true));
    expect(result.current.data?.items).toEqual([row]);
  });
});

describe("useCreate__Resource__", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("seeds the detail cache from the response and invalidates the lists", async () => {
    vi.mocked(apiPost).mockResolvedValue(row);
    const { queryClient, Wrapper } = createWrapper();
    const invalidate = vi.spyOn(queryClient, "invalidateQueries");

    const { result } = renderHook(() => useCreate__Resource__(), { wrapper: Wrapper });
    result.current.mutate({ name: "Test __resourceLabel__" });

    await waitFor(() => expect(result.current.isSuccess).toBe(true));

    // Seeding the detail cache is what makes "create, then open it" instant.
    expect(queryClient.getQueryData(__resource__Keys.detail(ID))).toEqual(row);
    // And the lists must be invalidated, because paging and `meta.total` are
    // server facts that just changed. This assertion is the one that catches a
    // key spelled differently at the invalidation site.
    expect(invalidate).toHaveBeenCalledWith({ queryKey: __resource__Keys.lists() });
  });
});
